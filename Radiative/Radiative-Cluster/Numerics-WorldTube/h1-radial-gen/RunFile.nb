   RowBox[{
    RowBox[{"configTags", "=", 
     RowBox[{"Files", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"configFiles", "=", 
     RowBox[{"Files", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ";"}]}]}]], "Code",
