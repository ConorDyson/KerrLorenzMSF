Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Create", " ", "the", " ", "configuration", " ", "files"}], "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"parituclardirectory", "=", 
     RowBox[{"(", 
      RowBox[{"savepath", "<>", "\"\</data\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"1000", "*", "a"}], "]"}], "]"}], "<>", "\"\</data\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"1000", "*", "a"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{"r0", "*", "10"}], ",", "1"}], "]"}], "]"}]}], ")"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"configformat", "[", "m_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"text", ",", "filename", ",", "filetag"}], "}"}], ",", 
       RowBox[{
        RowBox[{"text", "=", 
         RowBox[{"\"\<a\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "a", "]"}], "<>", "\"\<\\nr0\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "r0", "]"}], "<>", "\"\<\\nm\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<\\ntmax\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "tmax", "]"}], "<>", "\"\<\\nn\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<\\nangres\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "angres", "]"}], "<>", "\"\<\\ntwr\\t\>\"",
           "<>", 
          RowBox[{"ToString", "[", "twr", "]"}], "<>", "\"\<\\ntwq\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "twq", "]"}], "<>", "\"\<\\nnu\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "nu", "]"}], "<>", "\"\<\\npuncord\\t\>\"",
           "<>", 
          RowBox[{"ToString", "[", "puncord", "]"}], "<>", 
          "\"\<\\ngv_opt\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "gvopt", "]"}], "<>", 
          "\"\<\\nglg_opt\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "glgopt", "]"}], "<>", 
          "\"\<\\nic_opt\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "icopt", "]"}], "<>", 
          "\"\<\\nic_ampl\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "icampl", "]"}], "<>", 
          "\"\<\\nlmax\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "lmax", "]"}], "<>", "\"\<\\nlplot\\t\>\"",
           "<>", 
          RowBox[{"ToString", "[", "lplot", "]"}], "<>", 
          "\"\<\\nnterms\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "nterms", "]"}], "<>", 
          "\"\<\\ninford\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "inford", "]"}], "<>", 
          "\"\<\\nhorord\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "horord", "]"}], "<>", 
          "\"\<\\nrinf\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "rinf", "]"}], "<>", "\"\<\\nxhor\\t\>\"", 
          "<>", 
          RowBox[{"ToString", "[", "xhor", "]"}], "<>", "\"\<\\nrmax\\t\>\"", 
          "<>", 
          RowBox[{"ToString", "[", "rmax", "]"}], "<>", 
          "\"\<\\naccgoal\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "accgoal", "]"}], "<>", 
          "\"\<\\nkapord\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "kapord", "]"}], "<>", 
          "\"\<\\nprec\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "prec", "]"}], "<>", 
          "\"\<\\nrstmin\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "rstmin", "]"}], "<>", 
          "\"\<\\nrstmax\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "rstmax", "]"}], "<>", 
          "\"\<\\ndformat\\t\>\"", "<>", 
          RowBox[{"ToString", "[", "dformat", "]"}]}]}], ";", "\n", 
        RowBox[{"filetag", "=", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"Round", "[", 
            RowBox[{"1000", "*", "a"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"r0", "*", "10"}], ",", "1"}], "]"}], "]"}], "<>", 
          "\"\<-00\>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}]}]}], ";", "\n", 
        RowBox[{"filename", "=", 
         RowBox[{
         "\"\<config/config\>\"", "<>", "filetag", "<>", "\"\<.txt\>\""}]}], 
        ";", "\n", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{
          "parituclardirectory", "<>", "\"\</\>\"", "<>", "filename"}], ",", 
          "text"}], "]"}], ";", "\n", 
        RowBox[{"{", 
         RowBox[{"filetag", ",", "filename"}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellLabel->"In[35]:=",ExpressionUUID->"b60f3e20-50d8-4055-87d0-f52279715663"],

