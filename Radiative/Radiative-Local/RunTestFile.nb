Cell[BoxData[
 RowBox[{"prefac", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"a", " ", "m"}], 
            RowBox[{"2", "+", 
             RowBox[{"2", " ", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["a", "2"]}]]}]}]]}], "+", "\[Omega]"}], ")"}], 
        " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]], "-", 
          RowBox[{"Log", "[", "4", "]"}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["1", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["a", "2"]}]]]}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"4", "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"]}]}], "]"}]}]}], ")"}]}]], " ", 
      SuperscriptBox["x", "\[Nu]"]}], "/.", " ", 
     RowBox[{"\[Nu]", "->", " ", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", " ", "m"}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["a", "2"]}]]}], ")"}], " ", "\[Omega]"}]}], 
         ")"}]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}]]}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"x", "->", 
      RowBox[{"r", "-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}], ")"}]}]}], "}"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "->", "2"}], ",", 
     RowBox[{"\[Omega]", "->", "\[Omega]0"}]}], "}"}]}]}]], "Input",
