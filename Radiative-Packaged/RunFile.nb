Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<Now we Calculate the Radiative Solutions in Parallel\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"MetricReconstructRadiative", "[", 
      RowBox[{"OD", ",", 
       RowBox[{"{", 
        RowBox[{"lmax", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"rgridL", ",", "rgridR"}], "}"}], ",", 
       RowBox[{"configTags", "[", 
        RowBox[{"[", 
         RowBox[{"j", "+", "1"}], "]"}], "]"}], ",", 
       RowBox[{"NotebookDirectory", "[", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"WorkingPrecision", "->", "prec"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<nterms\>\"", "->", " ", "nterms"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Number", " ", "of", " ", "terms", " ", "in", " ", "the", " ", 
           "spherical", " ", 
           RowBox[{"expansion", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<kapord\>\"", "->", "kapord"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "\[Kappa]ord", " ", "is", " ", "the", " ", "maximum", " ", "order", 
           " ", "of", " ", "series", " ", "expansion", " ", "of", " ", 
           "\[Kappa]", " ", "in", " ", "spheroidal", " ", 
           RowBox[{"harmonics", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<rinf\>\"", "->", "rinf"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "rinf", " ", "is", " ", "the", " ", "radius", " ", "at", " ", 
           "which", " ", "the", " ", "series", " ", "solutions", " ", "for", 
           " ", "\[Kappa]_up", " ", "should", " ", "set", " ", "the", " ", 
           "initial", " ", "conditions", " ", "for", " ", "the", " ", 
           RowBox[{"integrator", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<rmax\>\"", "->", "rmax"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "rmax", " ", "is", " ", "the", " ", "maximum", " ", "value", " ", 
            "at", " ", "which", " ", "the", " ", "interpolating", " ", 
            "function", " ", "can", " ", "be", " ", "used"}], ",", " ", 
           RowBox[{
           "whereas", " ", "rinf", " ", "is", " ", "the", " ", "starting", 
            " ", "value", " ", "for", " ", "the", " ", "numerical", " ", 
            "integration"}], ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "the"}], " ", "radius", " ", 
            "at", " ", "which", " ", "the", " ", "initial", " ", "condition", 
            " ", "for", " ", "the", " ", "UP", " ", "solutions", " ", "of", 
            " ", "kappa", " ", "is", " ", "set"}], ",", " ", 
           RowBox[{"using", " ", "the", " ", "series", " ", 
            RowBox[{"expansion", "."}]}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<xhor\>\"", "->", "xhor"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<inford\>\"", "->", "inford"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "The", " ", "order", " ", "of", " ", "the", " ", "expansion", " ", 
           "at", " ", "infinity", " ", "for", " ", "the", " ", "UP", " ", 
           RowBox[{"function", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<horord\>\"", "->", "horord"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "The", " ", "order", " ", "of", " ", "the", " ", "expansion", " ", 
           "at", " ", "the", " ", "horizon", " ", "for", " ", "the", " ", 
           "IN", " ", 
           RowBox[{"function", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"AccuracyGoal", "->", "accgoal"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<rgrid\>\"", "->", "1"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Use", " ", "a", " ", "linearly"}], "-", 
             RowBox[{"spaced", " ", "grid", " ", "in", " ", "the", " ", 
              RowBox[{"variable", ":", " ", "0"}]}]}], " ", "=", " ", 
            "rstar"}], " ", ",", " ", 
           RowBox[{"1", " ", "=", " ", 
            RowBox[{"r", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<rstmin\>\"", "->", "rstmin"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<rstmax\>\"", "->", "rstmax"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<nres\>\"", "->", "n"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Resolution", " ", "in", " ", "the", " ", "r", "*", " ", 
            RowBox[{"direction", ":", "  ", 
             RowBox[{"dr", "*"}]}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"M", " ", "/", " ", "n"}], "  ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"or", " ", "dr"}], " ", "=", " ", 
               RowBox[{"M", " ", "/", " ", "n"}]}], ")"}], "."}]}]}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<angres\>\"", "->", "angres"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Resolution", " ", "in", " ", "the", " ", "\[Theta]", " ", 
            RowBox[{"direction", ":", " ", 
             RowBox[{"number", " ", "of", " ", "points"}]}]}], " ", "=", " ", 
           RowBox[{"nres", " ", "*", " ", 
            RowBox[{"qres", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<dformat\>\"", "->", "dformat"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"Data", " ", "format", " ", "for", " ", "output", " ", 
          RowBox[{"files", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        "}"}]}], "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"{", "2", "}"}]}], "}"}]}], "]"}], ";"}], "//", 
  "AbsoluteTiming"}]}], "Input",
