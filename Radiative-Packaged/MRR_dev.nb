        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"l", "+", " ", "m", "-"}], " ", "*)"}], "\n", 
      RowBox[{"cosmix", "=", "s1cosm11"}], ";", "\n", 
      RowBox[{"sinmix", "=", "s1sin0m1"}], ";", "\n", 
      RowBox[{"line1", "=", 
