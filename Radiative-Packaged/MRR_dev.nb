           RowBox[{
            RowBox[{"r", "*", "DcalPs1"}], "-", 
            RowBox[{"2", "*", "calPs1"}]}], ")"}], " ", ".", " ", 
          "Bmatm1"}]}], "+", 
        RowBox[{"I", "*", "a", "*", 
         RowBox[{"DcalPs1", " ", ".", " ", "Bmatm1", " ", ".", " ", 
          RowBox[{"CosMixMatrix", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1", ",", "lmax", ",", "mm"}], 
           "]"}]}]}]}]}], ";", "\n", 
      RowBox[{"tmp1", "=", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
        RowBox[{"signmat", " ", ".", " ", "Pp1vec"}]}]}], ";", "\n", 
      RowBox[{"tmp2", "=", 
       RowBox[{
        RowBox[{"r", "*", "\[Lambda]hat"}], "-", 
        RowBox[{"I", "*", "a", "*", 
         RowBox[{"\[Lambda]hat", " ", ".", " ", "cosmix"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", "*", "\[Omega]", "*", "r"}], "+", 
           RowBox[{"2", "*", "I", "*", "a"}]}], ")"}], "*", "sinmix"}], "+", 
        RowBox[{"I", "*", 
         RowBox[{"a", "^", "2"}], "*", "\[Omega]", "*", 
         RowBox[{"sinmix", " ", ".", " ", "cosmix"}]}]}]}], ";", "\n", 
      RowBox[{"line2", "=", 
