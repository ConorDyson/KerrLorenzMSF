     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"term1", "=", 
      RowBox[{
      "calPs1", " ", ".", " ", "SS0", " ", ".", " ", "\[CapitalSigma]mat"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"term2", "=", 
      RowBox[{
       RowBox[{"-", "2"}], "*", "r", "*", 
