         RowBox[{"-", "1"}]}], "&&", 
        RowBox[{"s2", "==", "1"}]}], ",", "\n", 
       RowBox[{
        RowBox[{"t0", "=", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
