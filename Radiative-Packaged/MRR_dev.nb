              RowBox[{"-", "2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"l1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], ";"}]}], "\n", "]"}], 
     ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Done", " ", "on", " ", 
        RowBox[{
         RowBox[{"20", "/", "11"}], "/", "22"}], " ", "late", " ", "night"}], 
       ",", " ", 
       RowBox[{"could", " ", "be", " ", "checked", " ", "one", " ", "more", " ", 
        RowBox[{"time", "."}]}]}], " ", "*)"}], "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Use", " ", "the", " ", 
       RowBox[{"symmetry", "."}]}], " ", "*)"}], "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"s1", "==", "0"}], "&&", 
        RowBox[{"s2", "==", "1"}]}], ",", 
       RowBox[{
        RowBox[{"t0", "=", 
         RowBox[{"mixsin", "[", 
          RowBox[{"s2", ",", "s1", ",", 
           RowBox[{"l", "+", "k"}], ",", 
