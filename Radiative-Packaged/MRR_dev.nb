            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "*", "l2"}], "+", "1"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"3", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", "l1"}], "+", "1"}], ")"}]}], ")"}]}]}], 
           "]"}], "*", 
          RowBox[{"ClebschGordan", "[", 
