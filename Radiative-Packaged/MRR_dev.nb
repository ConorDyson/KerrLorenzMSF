Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]hat", "[", 
    RowBox[{"lmax_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Lambda]hat", "[", 
     RowBox[{"lmax", ",", "m"}], "]"}], "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ll", "<", 
          RowBox[{"Abs", "[", "m", "]"}]}], ",", "0", ",", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"ll", "*", 
           RowBox[{"(", 
            RowBox[{"ll", "+", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "0", ",", "lmax"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]hat2", "[", 
    RowBox[{"lmax_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Lambda]hat2", "[", 
     RowBox[{"lmax", ",", "m"}], "]"}], "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ll", "<", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "m", "]"}], ",", "1"}], "]"}]}], ",", "0", ",", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ll", "-", "1"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"ll", "+", "2"}], ")"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "0", ",", "lmax"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]hat", "[", 
   RowBox[{"lmax_", ",", "m_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[CapitalLambda]hat", "[", 
    RowBox[{"lmax", ",", "m"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Lambda]hat", "[", 
     RowBox[{"lmax", ",", "m"}], "]"}], 
    RowBox[{"\[Lambda]2hat", "[", 
     RowBox[{"lmax", ",", "m"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"signmat", "[", 
