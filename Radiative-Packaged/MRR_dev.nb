         RowBox[{"Bmatm1", " ", ".", " ", 
          RowBox[{"SinMixMatrix", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "0", ",", "lmax", ",", "m"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"signmat", "[", 
           RowBox[{"lmax", ",", "m"}], "]"}], " ", ".", " ", "Bmatp1", " ", ".",
           " ", 
          RowBox[{"SinMixMatrix", "[", 
           RowBox[{"1", ",", "0", ",", "lmax", ",", "m"}], "]"}]}]}], 
        ")"}]}]}], ";", " ", 
     RowBox[{"Ss1lplp", "=", 
