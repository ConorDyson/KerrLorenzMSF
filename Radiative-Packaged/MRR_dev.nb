      RowBox[{"band", ",", "bands", ",", "k"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"bands", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"-", "2"}]}], ",", 
        RowBox[{"k", "<=", "2"}], ",", 
        RowBox[{"k", "++"}], ",", "\n", 
        RowBox[{
         RowBox[{"band", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mixsin", "[", 
             RowBox[{"s1", ",", "s2", ",", "ll", ",", "k", ",", "m"}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"ll", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"-", "k"}], ",", "0"}], "]"}], ",", 
              RowBox[{"Min", "[", 
               RowBox[{"lmax", ",", 
                RowBox[{"lmax", "-", "k"}]}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\n", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"bands", ",", "band"}], "]"}], ";"}]}], "\n", "]"}], ";", 
