           RowBox[{"\[Omega]", "^", "2"}], "*", 
           RowBox[{"SinMixMatrix", "[", 
            RowBox[{"2", ",", "0", ",", "lmax", ",", "mm"}], "]"}]}]}], 
         ")"}]}], ")"}], "/.", "awsubs"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SSminus", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Bmatm2", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"\[CapitalLambda]hat", "-", 
          RowBox[{"2", "*", "a", "*", "\[Omega]", "*", 
           RowBox[{"\[Lambda]2hat", " ", ".", " ", 
