     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t0", "=", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Bmatm1", "+", 
          RowBox[{
           RowBox[{"signmat", "[", 
