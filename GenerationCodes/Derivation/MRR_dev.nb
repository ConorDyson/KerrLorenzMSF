Cell[BoxData[
 RowBox[{
  RowBox[{"h\[Kappa]TSolveStep", "[", 
   RowBox[{
   "s_", ",", "l_", ",", "m_", ",", "a_", ",", "\[Omega]_", ",", "\[Lambda]_",
     ",", "\[Gamma]ll_", ",", "RDprev_", ",", "rprev_", ",", "rnew_", ",", 
    "rmax_", ",", "err_", ",", "nmax_", ",", "WP_", ",", "minstep_"}], "]"}], 
  ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"RDnew", "=", 
      RowBox[{"h\[Kappa]Ds", "[", 
       RowBox[{
       "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", "\[Lambda]", ",",
         "\[Gamma]ll", ",", "rnew", ",", "\[IndentingNewLine]", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"RDprev", "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], "[",
              "rnew", "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "1", "]"}], "[", 
              RowBox[{"RDprev", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], 
              "]"}], "[", "rnew", "]"}]}], "}"}], ",", "WP"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"RDprev", "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], "[",
              "rnew", "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "1", "]"}], "[", 
              RowBox[{"RDprev", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], 
              "]"}], "[", "rnew", "]"}]}], "}"}], ",", "WP"}], "]"}], 
        "\[IndentingNewLine]", ",", "nmax"}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ht0", "=", 
         RowBox[{
          RowBox[{"RDnew", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], "[", 
          FractionBox[
           RowBox[{"rnew", "+", "rprev"}], "2"], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ht1", "=", 
         RowBox[{
          RowBox[{"RDprev", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], "[", 
          FractionBox[
           RowBox[{"rnew", "+", "rprev"}], "2"], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Kappa]t0", "=", 
         RowBox[{
          RowBox[{"RDnew", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], "[", 
          FractionBox[
           RowBox[{"rnew", "+", "rprev"}], "2"], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Kappa]t1", "=", 
         RowBox[{
          RowBox[{"RDprev", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], "[", 
          FractionBox[
           RowBox[{"rnew", "+", "rprev"}], "2"], "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"rnew", "-", "rprev"}], "]"}], ">", "minstep"}], ")"}], "&&", 
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "@", 
             FractionBox[
              RowBox[{"ht0", "-", "ht1"}], 
              RowBox[{"FudgeZero", "@", 
               RowBox[{"Max", "[", 
                RowBox[{
                 RowBox[{"Abs", "@", "ht0"}], "+", 
                 RowBox[{"Abs", "@", "ht1"}]}], "]"}]}]]}], ">", "err"}], "||",
            " ", 
           RowBox[{
            RowBox[{"Abs", "@", 
             FractionBox[
              RowBox[{"\[Kappa]t0", "-", "\[Kappa]t1"}], 
              RowBox[{"FudgeZero", "@", 
               RowBox[{"Max", "[", 
                RowBox[{
                 RowBox[{"Abs", "@", "\[Kappa]t0"}], "+", 
                 RowBox[{"Abs", "@", "\[Kappa]t1"}]}], "]"}]}]]}], ">", 
            "err"}]}], ")"}], "&&", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"h\[Kappa]TSolveStep", "[", 
         RowBox[{
         "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", "\[Lambda]",
           ",", "\[Gamma]ll", ",", "RDprev", ",", "rprev", ",", 
          FractionBox[
           RowBox[{"rprev", "+", "rnew"}], "2"], ",", "rmax", ",", "err", ",",
           "nmax", ",", "WP", ",", "minstep"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sow", "[", 
          RowBox[{"First", "[", "RDnew", "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"rnew", "-", "rmax"}], "]"}], ">", 
            RowBox[{"rmax", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "WP"}]]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"h\[Kappa]TSolveStep", "[", 
            RowBox[{
            "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
             "\[Lambda]", ",", "\[Gamma]ll", ",", "RDnew", ",", "rnew", ",", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"rnew", "+", 
                RowBox[{
                 RowBox[{"Sign", "[", 
                  RowBox[{"rnew", "-", "rprev"}], "]"}], " ", "\[IndentingNewLine]", 
                 RowBox[{"Min", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Max", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox["err", 
                    RowBox[{
                    "RDnew", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]], ")"}], 
                    RowBox[{"1", "/", "nmax"}]], "]"}], ",", 
                    "\[IndentingNewLine]", "minstep"}], "\[IndentingNewLine]",
                     "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"Quiet", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"\[Pi]", "/", "\[Omega]"}], "]"}], ",", 
                    RowBox[{"{", 
                    StyleBox[
                    RowBox[{"Power", "::", "infy"}], "MessageName"], "}"}]}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"Abs", "[", 
                    RowBox[{"rmax", "-", "rnew"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"2", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"rnew", "-", "rprev"}], "]"}]}]}], 
                  "\[IndentingNewLine]", "]"}]}]}], ",", 
               "\[IndentingNewLine]", "WP"}], "]"}], ",", "rmax", ",", "err", 
             ",", "nmax", ",", "WP", ",", "minstep"}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
