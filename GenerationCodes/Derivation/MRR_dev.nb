          RowBox[{"s2", ",", "s1", ",", 
           RowBox[{"l", "+", "k"}], ",", 
           RowBox[{"-", "k"}], ",", "m"}], "]"}]}], ";"}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
