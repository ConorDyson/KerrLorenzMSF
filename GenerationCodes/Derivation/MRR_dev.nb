          RowBox[{"OptionValue", "[", "MaxSteps", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"$MinPrecision", "=", "WP"}]}], "\[IndentingNewLine]", "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ics", "=", 
