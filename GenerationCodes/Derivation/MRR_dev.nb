         RowBox[{
         "m", ",", "a", ",", "\[Omega]", ",", "\[Lambda]", ",", "\[Gamma]ll", 
          ",", 
          RowBox[{"OptionValue", "[", "Order", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"itable", "=", "\[IndentingNewLine]", 
        RowBox[{"Sort", "@", 
         RowBox[{
          RowBox[{"Reap", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"rd0", "=", 
             RowBox[{"h\[Kappa]Ds", "[", 
              RowBox[{
              "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
               "\[Lambda]", ",", "\[Gamma]ll", ",", "r0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ics", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "[", "r0", "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ics", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "'"}], "[", "r0", "]"}]}],
                 "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                  "ics", "\[LeftDoubleBracket]", "2", 
                   "\[RightDoubleBracket]"}], "[", "r0", "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "ics", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "'"}], "[", "r0", "]"}]}], 
                "}"}], ",", "nmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Sow", "[", 
             RowBox[{"First", "[", "rd0", "]"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"h\[Kappa]TSolveStep", "[", 
             RowBox[{
             "s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
              "\[Lambda]", ",", "rd0", ",", "r0", ",", 
              RowBox[{"r0", "+", " ", 
               RowBox[{
                RowBox[{"Sign", "[", 
                 RowBox[{"r1", "-", "r0"}], "]"}], 
                RowBox[{"SetPrecision", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Min", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Max", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox["err", 
                    RowBox[{
                    "rd0", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]], ")"}], 
                    RowBox[{"1", "/", "nmax"}]], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    FractionBox[
                    RowBox[{"Abs", "[", 
                    RowBox[{"r1", "-", "r0"}], "]"}], 
                    RowBox[{"OptionValue", "[", "MaxSteps", "]"}]]}], 
                    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"\[Pi]", "/", "\[Omega]"}], "]"}], ",", 
                    RowBox[{"{", 
                    StyleBox[
                    RowBox[{"Power", "::", "infy"}], "MessageName"], "}"}]}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"r1", "-", "r0"}], "]"}]}], "\[IndentingNewLine]",
                    "]"}], ",", "WP"}], "]"}]}]}], ",", "\[IndentingNewLine]",
               "r1", ",", "err", ",", "nmax", ",", "WP", ",", 
              FractionBox[
               RowBox[{"Abs", "[", 
                RowBox[{"r1", "-", "r0"}], "]"}], 
               RowBox[{"OptionValue", "[", "MaxSteps", "]"}]]}], "]"}]}], 
           "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"itable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "\[Rule]", 
            RowBox[{"2", "nmax"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"itable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "\[Rule]", 
            RowBox[{"2", "nmax"}]}]}], "]"}]}], "\[IndentingNewLine]", 
        "}"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
