Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Calcs1components", "[", 
    RowBox[{"rtry_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", 
      RowBox[{
      "line1", ",", "line2", ",", "tmp1", ",", "tmp2", ",", "term1", ",", 
       "term2", ",", "term3", ",", "tmp", ",", "\[CapitalDelta]Ktbl", ",", 
       "myP1subs", ",", "\n", "Pm1vec", ",", "Pp1vec", ",", "Dm1Pp1", ",", 
       "Ddagm1Pm1", ",", "DdagPp1", ",", "DPm1", ",", "calPs1", ",", 
       "DcalPs1", ",", "\n", "DdagcalPs1", ",", "cosmix", ",", "sinmix", ",", 
       "\[CapitalSigma]mat", ",", "\n", "hraws1lplp", ",", "hraws1lmlm", ",", 
       "hraws1mpmp", ",", "hraws1mmmm", ",", "\n", "\[Rho]hraws1lpmp", ",", 
       "\[Rho]chraws1lpmm", ",", "\[Rho]chraws1lmmp", ",", "\[Rho]hraws1lmmm",
        ",", "\[CapitalSigma]\[CapitalDelta]hraws1lplm"}], "}"}], ",", "\n", 
     "\n", 
     RowBox[{
      RowBox[{"\[CapitalDelta]Ktbl", "=", 
       RowBox[{
        RowBox[{"EvaluateRHS", "[", 
         RowBox[{"\[CapitalDelta]Ksubs", ",", "rtry"}], "]"}], "/.", 
        "awsubs"}]}], ";", "\n", 
      RowBox[{"myP1subs", "=", 
       RowBox[{"GetPsubsAll", "[", 
        RowBox[{"1", ",", "rtry"}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Pm1vec", ",", "Pp1vec", ",", "Dm1Pp1", ",", "Ddagm1Pm1", ",", "\n", 
         "DdagPp1", ",", "DPm1", ",", "\n", "calPs1", ",", "DcalPs1", ",", 
         "DdagcalPs1"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "aPm1vec", ",", "aPp1vec", ",", "aDm1Pp1", ",", "aDdagm1Pm1", ",",
              "aDdagPp1", ",", "aDPm1", ",", "\n", "acalPs1", ",", "aDcalPs1",
              ",", "aDdagcalPs1"}], "}"}], "/.", "\[CapitalDelta]Ktbl"}], "/.",
           "awsubs"}], "/.", "myP1subs"}], "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"l", "+", " ", "l", "+"}], ",", " ", 
        RowBox[{"l", "-", " ", "l", "-"}]}], " ", "*)"}], "\n", 
      RowBox[{"tmp", "=", 
       RowBox[{
        RowBox[{"2", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", "Dm1Pp1"}]}], ";",
       "\n", 
      RowBox[{"hraws1lplp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"tmp", " ", ".", " ", "signmat", " ", ".", " ", "Ss1lplp"}],
           "/.", "\[CapitalDelta]Ktbl"}], "/.", "awsubs"}], "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", 
      RowBox[{"tmp", "=", 
       RowBox[{
        RowBox[{"2", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", "Ddagm1Pm1"}]}], ";",
       "\n", 
      RowBox[{"hraws1lmlm", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"tmp", " ", ".", " ", "Ss1lmlm"}], "/.", 
          "\[CapitalDelta]Ktbl"}], "/.", "awsubs"}], "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"m", "+", " ", "m", "+"}], ",", " ", 
        RowBox[{"m", "-", " ", "m", "-"}]}], " ", "*)"}], "\n", 
      RowBox[{"tmp", "=", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"signmat", " ", ".", " ", "DdagPp1"}], "+", "DPm1"}], 
         ")"}]}]}], ";", "\n", 
      RowBox[{"hraws1mpmp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"tmp", " ", ".", " ", "signmat", " ", ".", " ", "Ss1mpmp"}],
           "/.", "\[CapitalDelta]Ktbl"}], "/.", "awsubs"}], "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", 
      RowBox[{"hraws1mmmm", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"tmp", " ", ".", " ", "Ss1mmmm"}]}], "/.", 
          "\[CapitalDelta]Ktbl"}], "/.", "awsubs"}], "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rtry"}], "}"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"l", "+", " ", "m", "+"}], " ", "*)"}], "\n", 
      RowBox[{"cosmix", "=", "s1cos11"}], ";", "\n", 
      RowBox[{"sinmix", "=", "s1sin01"}], ";", "\n", 
      RowBox[{"line1", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"signmat", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "*", "DcalPs1"}], "-", 
             RowBox[{"2", "*", "calPs1"}]}], ")"}]}], ")"}], " ", ".", " ", 
         "Bmatp1"}], "+", 
        RowBox[{"I", "*", "a", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"signmat", " ", ".", " ", "DcalPs1"}], ")"}], " ", ".", 
          " ", "Bmatp1", " ", ".", " ", "cosmix"}]}]}]}], ";", "\n", 
      RowBox[{"tmp1", "=", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
        RowBox[{"signmat", " ", ".", " ", "Pp1vec"}]}]}], ";", "\n", 
      RowBox[{"tmp2", "=", 
