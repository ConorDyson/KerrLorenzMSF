Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SinMixMatrix2", "[", 
    RowBox[{"s1_", ",", "s2_", ",", "lmax_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"band", ",", "bands", ",", "k"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"bands", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"-", "2"}]}], ",", 
        RowBox[{"k", "<=", "2"}], ",", 
        RowBox[{"k", "++"}], ",", "\n", 
        RowBox[{
         RowBox[{"band", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mixsin", "[", 
             RowBox[{"s1", ",", "s2", ",", "ll", ",", "k", ",", "m"}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"ll", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"-", "k"}], ",", "0"}], "]"}], ",", 
              RowBox[{"Min", "[", 
               RowBox[{"lmax", ",", 
                RowBox[{"lmax", "-", "k"}]}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\n", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"bands", ",", "band"}], "]"}], ";"}]}], "\n", "]"}], ";", 
      "\n", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
           RowBox[{"bands", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", 
           RowBox[{"bands", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"3", ",", "1"}], "}"}], "]"}], "->", 
           RowBox[{"bands", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", 
           RowBox[{"bands", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3"}], "}"}], "]"}], "->", 
           RowBox[{"bands", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lmax", "+", "1"}], ",", 
          RowBox[{"lmax", "+", "1"}]}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
