Cell[BoxData[
 RowBox[{
  RowBox[{"h\[Kappa]TSolve", "[", 
   RowBox[{
   "s_", ",", "l_", ",", "m_", ",", "a_", ",", "\[Omega]_", ",", "\[Lambda]_",
     ",", "\[Gamma]ll_", ",", 
    RowBox[{"{", 
     RowBox[{"r0_", ",", "r1_"}], "}"}], ",", "seriesF_Symbol", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"OptionsPattern", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PrecisionGoal", "\[Rule]", " ", "$TeukolskyPrecisionGoal"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
       "WorkingPrecision", "\[Rule]", " ", "$TeukolskyWorkingPrecision"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"MaxSteps", "\[Rule]", " ", 
        SuperscriptBox["10", "5"]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Order", "\[Rule]", " ", "30"}]}], "\[IndentingNewLine]", 
      "}"}], "]"}]}], "\[IndentingNewLine]", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"itable", ",", "\[IndentingNewLine]", 
      RowBox[{"nmax", "=", 
       RowBox[{"OptionValue", "[", "Order", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"WP", "=", 
       RowBox[{"Max", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"OptionValue", "@", "WorkingPrecision"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"OptionValue", "@", "PrecisionGoal"}], "+", 
          RowBox[{"OptionValue", "@", "Order"}]}], ",", "\[IndentingNewLine]",
          "$MinPrecision"}], "\[IndentingNewLine]", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"err", "=", 
       SuperscriptBox["10", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"OptionValue", "[", "PrecisionGoal", "]"}], "+", "2"}], 
          ")"}]}]]}], ",", "\[IndentingNewLine]", "rd0", ",", 
      "\[IndentingNewLine]", "rd1", ",", "\[IndentingNewLine]", "ics"}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"$RecursionLimit", "=", 
