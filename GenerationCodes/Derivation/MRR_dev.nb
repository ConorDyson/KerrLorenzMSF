                 RowBox[{"(", 
                  RowBox[{"lprime", "/.", "tbl"}], ")"}]}]}], "]"}], ";"}]}], 
            "\n", "]"}], ";"}]}], "\n", "]"}], ";", "\n", "\n", 
        RowBox[{"AppendTo", "[", 
