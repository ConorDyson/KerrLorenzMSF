Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bmatEV", "[", 
    RowBox[{
    "s_", ",", "m_", ",", "c_", ",", "lmax_", ",", "\[IndentingNewLine]", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"WorkingPrecision", "\[RuleDelayed]", " ", "32"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AccuracyGoal", "->", "16"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<lpadding\>\"", "\[RuleDelayed]", " ", "Automatic"}]}], 
        "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "]"}]}]}], "]"}],
    ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"lpad", ",", "acc", ",", "lmin", ",", "btemp", ",", "evs"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"acc", "=", 
       RowBox[{"OptionValue", "[", "AccuracyGoal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lmin", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", "m", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lpad", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<lpadding\>\"", "]"}], "===", " ", 
          "Automatic"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"PossibleZeroQ", "@", "c"}], ",", "0", ",", 
             RowBox[{"Ceiling", "[", 
              FractionBox[
               RowBox[{"acc", "+", 
                RowBox[{"4", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"Log10", "[", 
                    RowBox[{"Abs", "@", "c"}], "]"}]}], ")"}]}]}], 
               RowBox[{"4", "-", 
                RowBox[{"2", 
                 RowBox[{"Log10", "[", 
                  RowBox[{"Abs", "@", "c"}], "]"}]}]}]], "]"}]}], "]"}], ",", 
           "5"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"OptionValue", "[", "\"\<lpadding\>\"", "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"btemp", ",", "evs"}], "}"}], "=", 
       RowBox[{"SWSHb", "[", 
        RowBox[{"s", ",", "m", ",", "c", ",", "\[IndentingNewLine]", 
         RowBox[{"WorkingPrecision", "->", 
          RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<lmax\>\"", "->", 
          RowBox[{"lmax", "+", "lpad"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<EigenValues\>\"", "->", "True"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ArrayPad", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"With", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"imax", "=", 
              RowBox[{"Length", "@", "btemp"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Around", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"btemp", "[", 
                 RowBox[{"[", 
                  RowBox[{"iI", ",", "iJ"}], "]"}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"iI", "+", "iJ"}], "\[LessEqual]", "imax"}], ",", 
                  "\[IndentingNewLine]", 
                  SuperscriptBox["10", 
                   RowBox[{"-", 
                    RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}]], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{"Max", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Abs", "@", 
                    RowBox[{"btemp", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"iI", "+", "iJ", "-", "imax"}], ",", "imax"}], 
                    "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Abs", "@", 
                    RowBox[{"btemp", "\[LeftDoubleBracket]", 
                    RowBox[{"imax", ",", 
                    RowBox[{"iJ", "+", "iI", "-", "imax"}]}], 
                    "\[RightDoubleBracket]"}]}]}], "\[IndentingNewLine]", 
                   "]"}]}], "\[IndentingNewLine]", "]"}]}], 
               "\[IndentingNewLine]", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"iI", ",", "1", ",", 
                RowBox[{"lmax", "+", "1", "-", 
                 RowBox[{"Abs", "[", "lmin", "]"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"iJ", ",", "1", ",", 
                RowBox[{"lmax", "+", "1", "-", 
                 RowBox[{"Abs", "[", "lmin", "]"}]}]}], "}"}]}], "]"}]}], 
           "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"lmin", ",", "0"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"ArrayPad", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "s"}], 
            RowBox[{"(", 
             RowBox[{"s", "+", "1"}], ")"}]}], "-", 
           RowBox[{"2", "m", " ", "c"}], " ", "+", 
           SuperscriptBox["c", "2"], "-", 
           RowBox[{"evs", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", 
              RowBox[{"(", 
               RowBox[{"lmax", "+", "1", "-", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"Abs", "[", "m", "]"}], ",", 
                  RowBox[{"Abs", "[", "s", "]"}]}], "]"}]}], ")"}]}], "]"}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "m", "]"}], ",", 
              RowBox[{"Abs", "[", "s", "]"}]}], "]"}], ",", "0"}], "}"}]}], 
         "]"}]}], "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}]], "Input",
