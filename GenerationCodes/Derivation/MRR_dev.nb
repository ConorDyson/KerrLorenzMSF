          RowBox[{"s2", ",", "s1", ",", 
           RowBox[{"l", "+", "k"}], ",", 
           RowBox[{"-", "k"}], ",", "m"}], "]"}]}], ";"}]}], "]"}], ";", "\n", 
     RowBox[{"Simplify", "[", "t0", "]"}]}]}], "\n", "]"}]}]], "Input",
