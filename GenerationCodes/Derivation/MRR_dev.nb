        RowBox[{"\[Lambda]hat", "[", 
         RowBox[{"lmax", ",", "m"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{"a", " ", "\[Omega]", "*", 
