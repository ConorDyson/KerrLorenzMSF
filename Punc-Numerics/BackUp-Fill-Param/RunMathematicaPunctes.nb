       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "+", 
            RowBox[{"I", " ", "a0", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"punc$hs1", "[", 
           RowBox[{"\"\<lm\>\"", ",", "r", ",", "\[Theta]", ",", "m"}], "]"}],
