      RowBox[{
       RowBox[{"func$mmmm", "[", 
        RowBox[{"r_", ",", "\[Theta]_", ",", "m_"}], "]"}], ":=", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"I", " ", "a0", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"punc$hs1", "[", 
