Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RunPuncs", "[", 
    RowBox[{
    "aInput_", ",", "rInput_", ",", "ll_", ",", "mm_", ",", "rvalsInput_", 
     ",", 
     RowBox[{"Prec_", ":", "MachinePrecision"}], ",", 
     RowBox[{"PrecGoal_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "a0", ",", "r0", ",", "M0", ",", "func$lplp", ",", "func$lmlm", ",", 
       "func$mpmp", ",", "func$mmmm", ",", "func$lpmp", ",", "func$lpmm", ",",
        "func$lmmp", ",", "func$lmmm", ",", "func$lplm", ",", "func$trace", 
       ",", "func$list", ",", "s$list", ",", "method$opt", ",", 
       "punc$test$worldtube$list$comp$temp2", ",", "rvals"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a0", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"aInput", ",", "Prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"r0", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"rInput", ",", "Prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"rvals", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"rvalsInput", ",", "Prec"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"M0", "=", "1"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"punc$hs1", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"LoadKerrPuncture", "[", 
          RowBox[{"\"\<hS1\>\"", ",", " ", "M0", ",", "a0", ",", " ", "r0"}], 
          "]"}], ",", "Prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "integrand$NB", "]"}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"window", "[", 
        RowBox[{"\[Theta]_", ",", "x0_", ",", "w_", ",", "q_", ",", "s_"}], 
        "]"}], ":=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"\[Theta]", "<=", "x0"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "/", "2"}], "+", 
              RowBox[{
               RowBox[{"Tanh", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"s", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"q", "^", "2"}], "*", 
                    RowBox[{"Cot", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Pi", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "x0"}], "+", "\[Theta]"}], ")"}]}], ")"}], 
                    "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "*", "w"}], ")"}]}], "]"}]}], ")"}]}], "+", 
                    RowBox[{"Tan", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Pi", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "x0"}], "+", "\[Theta]"}], ")"}]}], ")"}], 
                    "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "*", "w"}], ")"}]}], "]"}]}], ")"}]}], ")"}],
                  "/", "Pi"}], "]"}], "/", "2"}]}], ",", 
             RowBox[{"x0", "<", "\[Theta]", "<", 
              RowBox[{"w", "+", "x0"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{
              RowBox[{"Pi", "-", "w", "-", "x0"}], ">=", "\[Theta]", ">=", 
              RowBox[{"w", "+", "x0"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "/", "2"}], "+", 
              RowBox[{
               RowBox[{"Tanh", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"s", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"q", "^", "2"}], "*", 
                    RowBox[{"Cot", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Pi", "*", 
                    RowBox[{"(", 
                    RowBox[{"Pi", "-", "x0", "-", "\[Theta]"}], ")"}]}], 
                    ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "*", "w"}], ")"}]}], "]"}]}], ")"}]}], "+", 
                    RowBox[{"Tan", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Pi", "*", 
                    RowBox[{"(", 
                    RowBox[{"Pi", "-", "x0", "-", "\[Theta]"}], ")"}]}], 
                    ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "*", "w"}], ")"}]}], "]"}]}], ")"}]}], ")"}],
                  "/", "Pi"}], "]"}], "/", "2"}]}], ",", 
             RowBox[{
              RowBox[{"Pi", "-", "x0"}], ">", "\[Theta]", ">", 
              RowBox[{"Pi", "-", "w", "-", "x0"}]}]}], "}"}]}], "}"}], ",", 
         "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"WindowFunc", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "Global`\[Theta]", "}"}], ",", 
         RowBox[{"window", "[", 
          RowBox[{"Global`\[Theta]", ",", 
           RowBox[{"1", "/", "100"}], ",", " ", 
           RowBox[{"6", " ", 
            RowBox[{"\[Pi]", "/", "16"}]}], ",", "1", ",", "3"}], "]"}], ",", 
         "Listable"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integrand$NB", "[", 
        RowBox[{
        "s_", ",", "l_", ",", "m_", ",", "r_", ",", "\[Theta]_", ",", 
