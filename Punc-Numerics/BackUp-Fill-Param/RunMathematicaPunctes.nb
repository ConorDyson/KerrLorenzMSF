         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{
              RowBox[{"a0", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], 
           "^", "2"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a0", "^", "2"}], " ", "-", 
             RowBox[{"2", "r"}]}], ")"}], "^", "2"}]}], 
         RowBox[{"(", 
          RowBox[{"punc$hs1", "[", 
           RowBox[{"\"\<nn\>\"", ",", "r", ",", "\[Theta]", ",", "m"}], "]"}],
           ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"func$mpmp", "[", 
        RowBox[{"r_", ",", "\[Theta]_", ",", "m_"}], "]"}], ":=", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "+", 
            RowBox[{"I", " ", "a0", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"punc$hs1", "[", 
           RowBox[{"\"\<mm\>\"", ",", "r", ",", "\[Theta]", ",", "m"}], "]"}],
